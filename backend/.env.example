# MongoDB Connection
DATABASE_URL=mongodb://localhost:27017

# Groq API Key (Required for AI features)
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE

# Server Port
PORT=8080

# Security (Required for Auth)
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_TO_A_REAL_SECRET

# Google OAuth (Required for Social Login)
GOOGLE_CLIENT_ID=your_google_client_id_here

# Frontend URL (Required for CORS in production)
# Comma-separated for multiple origins, e.g.: https://yourdomain.com,https://*.vercel.app
FRONTEND_URL=http://localhost:3000
